[{"sha": "7414704e88d73dafbcfbb85f9bc54cb6111439d3", "node_id": "C_kwDOAD-LgtoAKDc0MTQ3MDRlODhkNzNkYWZiY2ZiYjg1ZjliYzU0Y2I2MTExNDM5ZDM", "commit": {"author": {"name": "Ian Foote", "email": "python@ian.feete.org", "date": "2020-11-22T22:27:57Z"}, "committer": {"name": "Mariusz Felisiak", "email": "felisiak.mariusz@gmail.com", "date": "2023-05-12T17:11:40Z"}, "message": "Fixed #470 -- Added support for database defaults on fields.\n\nSpecial thanks to Hannes Ljungberg for finding multiple implementation\ngaps.\n\nThanks also to Simon Charette, Adam Johnson, and Mariusz Felisiak for\nreviews.", "tree": {"sha": "f51136b16e457d7f46e01ff3cc06308faf0923db", "url": "https://api.github.com/repos/django/django/git/trees/f51136b16e457d7f46e01ff3cc06308faf0923db"}, "url": "https://api.github.com/repos/django/django/git/commits/7414704e88d73dafbcfbb85f9bc54cb6111439d3", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/django/django/commits/7414704e88d73dafbcfbb85f9bc54cb6111439d3", "html_url": "https://github.com/django/django/commit/7414704e88d73dafbcfbb85f9bc54cb6111439d3", "comments_url": "https://api.github.com/repos/django/django/commits/7414704e88d73dafbcfbb85f9bc54cb6111439d3/comments", "author": null, "committer": {"login": "felixxm", "id": 2865885, "node_id": "MDQ6VXNlcjI4NjU4ODU=", "avatar_url": "https://avatars.githubusercontent.com/u/2865885?v=4", "gravatar_id": "", "url": "https://api.github.com/users/felixxm", "html_url": "https://github.com/felixxm", "followers_url": "https://api.github.com/users/felixxm/followers", "following_url": "https://api.github.com/users/felixxm/following{/other_user}", "gists_url": "https://api.github.com/users/felixxm/gists{/gist_id}", "starred_url": "https://api.github.com/users/felixxm/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/felixxm/subscriptions", "organizations_url": "https://api.github.com/users/felixxm/orgs", "repos_url": "https://api.github.com/users/felixxm/repos", "events_url": "https://api.github.com/users/felixxm/events{/privacy}", "received_events_url": "https://api.github.com/users/felixxm/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "599f3e2cda50ab084915ffd08edb5ad6cad61415", "url": "https://api.github.com/repos/django/django/commits/599f3e2cda50ab084915ffd08edb5ad6cad61415", "html_url": "https://github.com/django/django/commit/599f3e2cda50ab084915ffd08edb5ad6cad61415"}]}, {"sha": "ffff17d4b0117cce59f65c9f56fa164694eafd23", "node_id": "C_kwDOAD-LgtoAKGZmZmYxN2Q0YjAxMTdjY2U1OWY2NWM5ZjU2ZmExNjQ2OTRlYWZkMjM", "commit": {"author": {"name": "Simon Charette", "email": "charette.s@gmail.com", "date": "2023-05-10T02:34:43Z"}, "committer": {"name": "Mariusz Felisiak", "email": "felisiak.mariusz@gmail.com", "date": "2023-05-10T15:25:57Z"}, "message": "Fixed #34553 -- Fixed improper % escaping of literal in constraints.\n\nProper escaping of % in string literals used when defining constaints\nwas attempted (a8b3f96f6) by overriding quote_value of Postgres and\nOracle schema editor. The same approach was used when adding support for\nconstraints to the MySQL/MariaDB backend (1fc2c70).\n\nLater on it was discovered that this approach was not appropriate and\nthat a preferable one was to pass params=None when executing the\nconstraint creation DDL to avoid any form of interpolation in the first\nplace (42e8cf47).\n\nWhen the second patch was applied the corrective of the first were not\nremoved which caused % literals to be unnecessary doubled. This flew\nunder the radar because the existings test were crafted in a way that\nconsecutive %% didn't catch regressions.\n\nThis commit introduces an extra test for __exact lookups which\nhighlights more adequately % doubling problems but also adjust a\nprevious __endswith test to cover % doubling problems (%\\% -> %%\\%%).\n\nThanks Thomas Kolar for the report.\n\nRefs #32369, #30408, #30593.", "tree": {"sha": "f0a756b34808b12bceab28cad2cbcb4dc69b612a", "url": "https://api.github.com/repos/django/django/git/trees/f0a756b34808b12bceab28cad2cbcb4dc69b612a"}, "url": "https://api.github.com/repos/django/django/git/commits/ffff17d4b0117cce59f65c9f56fa164694eafd23", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/django/django/commits/ffff17d4b0117cce59f65c9f56fa164694eafd23", "html_url": "https://github.com/django/django/commit/ffff17d4b0117cce59f65c9f56fa164694eafd23", "comments_url": "https://api.github.com/repos/django/django/commits/ffff17d4b0117cce59f65c9f56fa164694eafd23/comments", "author": {"login": "charettes", "id": 9293, "node_id": "MDQ6VXNlcjkyOTM=", "avatar_url": "https://avatars.githubusercontent.com/u/9293?v=4", "gravatar_id": "", "url": "https://api.github.com/users/charettes", "html_url": "https://github.com/charettes", "followers_url": "https://api.github.com/users/charettes/followers", "following_url": "https://api.github.com/users/charettes/following{/other_user}", "gists_url": "https://api.github.com/users/charettes/gists{/gist_id}", "starred_url": "https://api.github.com/users/charettes/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/charettes/subscriptions", "organizations_url": "https://api.github.com/users/charettes/orgs", "repos_url": "https://api.github.com/users/charettes/repos", "events_url": "https://api.github.com/users/charettes/events{/privacy}", "received_events_url": "https://api.github.com/users/charettes/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "felixxm", "id": 2865885, "node_id": "MDQ6VXNlcjI4NjU4ODU=", "avatar_url": "https://avatars.githubusercontent.com/u/2865885?v=4", "gravatar_id": "", "url": "https://api.github.com/users/felixxm", "html_url": "htt