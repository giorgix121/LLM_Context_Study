[{"sha": "67b958c4e3bd720abac3a81cf0348427740f3627", "node_id": "C_kwDOAgUK29oAKDY3Yjk1OGM0ZTNiZDcyMGFiYWMzYTgxY2YwMzQ4NDI3NzQwZjM2Mjc", "commit": {"author": {"name": "Ash Berlin-Taylor", "email": "ash@apache.org", "date": "2022-11-28T11:52:30Z"}, "committer": {"name": "GitHub", "email": "noreply@github.com", "date": "2022-11-28T11:52:30Z"}, "message": "Make updating breeze deps via breeze easier. (#27958)\n\nIn trying to update the deps of breeze, I made a change to `setup.cfg`\r\nand then rand `breeze static-checks update-breeze-readme-config-hash`\r\nand ran in to two problems that this fixes\r\n\r\n1. It prevents a self-update loop, where the change to `setup.cfg` was\r\n   detected, but the hash in the README hasn't been updated, so it just\r\n   came around again and just tried to reinstall again and again and\r\n   again.\r\n\r\n2. This correctly sets/maintains `argv[0]` for the re-exec'd process\r\n   (which is what `sys.executable` gets set to) so that when we do\r\n   `assert_pre_commit_installed` and try to find the pre-commit version,\r\n   we don't invoke breeze again by mistake!", "tree": {"sha": "68c2ec91ef8d11d813a8b9a3c8f5a48a3b735671", "url": "https://api.github.com/repos/apache/airflow/git/trees/68c2ec91ef8d11d813a8b9a3c8f5a48a3b735671"}, "url": "https://api.github.com/repos/apache/airflow/git/commits/67b958c4e3bd720abac3a81cf0348427740f3627", "comment_count": 0, "verification": {"verified": true, "reason": "valid", "signature": "-----BEGIN PGP SIGNATURE-----\n\nwsBcBAABCAAQBQJjhKD+CRBK7hj4Ov3rIwAAM20IAEdQjnYH/LmCyGXjK+5DmAdo\nlT/6FDAg7fPxyGTv2kW1LplAMYn9ggbMex2c4ImbkK94UND08FFhYZyvIpKc0dZF\neMcN3sjCriDLNDpiU5v8FuHn29cg8QDp8ZOvm0sFCXBZKhIuDZL4Iy0Ou1A3Qw4d\n2EzjIBhLflGfDacfnI3XlEAjx8YcaLX07/RAgcMflAN1iLgSBlqTvDiQBBIxGkLd\nJHMeQzzN9Lo67hAfcno2oJz6tW/xagr3WuEeiDflRlhDYg/0k99FHcXa4rZD4wjg\njjQXEYrLx+6WEr36NPg4Wff5M5Pla1hwaPWsvbtzZlwnFkHhdhlMNRoVB9BQW8Y=\n=cw8h\n-----END PGP SIGNATURE-----\n", "payload": "tree 68c2ec91ef8d11d813a8b9a3c8f5a48a3b735671\nparent 3ea4739e2172e994e2215d61dd3b4f37f2c64759\nauthor Ash Berlin-Taylor <ash@apache.org> 1669636350 +0000\ncommitter GitHub <noreply@github.com> 1669636350 +0000\n\nMake updating breeze deps via breeze easier. (#27958)\n\nIn trying to update the deps of breeze, I made a change to `setup.cfg`\r\nand then rand `breeze static-checks update-breeze-readme-config-hash`\r\nand ran in to two problems that this fixes\r\n\r\n1. It prevents a self-update loop, where the change to `setup.cfg` was\r\n   detected, but the hash in the README hasn't been updated, so it just\r\n   came around again and just tried to reinstall again and again and\r\n   again.\r\n\r\n2. This correctly sets/maintains `argv[0]` for the re-exec'd process\r\n   (which is what `sys.executable` gets set to) so that when we do\r\n   `assert_pre_commit_installed` and try to find the pre-commit version,\r\n   we don't invoke breeze again by mistake!", "verified_at": "2024-01-16T19:59:59Z"}}, "url": "https://api.github.com/repos/apache/airflow/commits/67b958c4e3bd720abac3a81cf0348427740f3627", "html_url": "https://github.com/apache/airflow/commit/67b958c4e3bd720abac3a81cf0348427740f3627", "comments_url": "https://api.github.com/repos/apache/airflow/commits/67b958c4e3bd720abac3a81cf0348427740f3627/comments", "author": {"login": "ashb", "id": 34150, "node_id": "MDQ6VXNlcjM0MTUw", "avatar_url": "https://avatars.githubusercontent.com/u/34150?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ashb", "html_url": "https://github.com/ashb", "followers_url": "https://api.github.com/users/ashb/followers", "following_url": "https://api.github.com/users/ashb/following{/other_user}", "gists_url": "https://api.github.com/users/ashb/gists{/gist_id}", "starred_url": "https://api.github.com/users/ashb/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ashb/subscriptions", "organizations_url": "https://api.github.com/users/ashb/orgs", "repos_url": "https://api.github.com/users/ashb/repos", "