ch that it now uses the GitHub asset name (which can not use the release data anymore, but this wasn't needed in the first place).\r\n\r\nThis might cause minor conflicts with https://github.com/localstack/localstack/pull/6916.\r\nFixes https://github.com/localstack/localstack/issues/7000.", "created_at": "2022-10-11T08:07:28Z", "updated_at": "2022-10-11T11:18:01Z", "closed_at": "2022-10-11T11:17:58Z", "merged_at": "2022-10-11T11:17:58Z", "merge_commit_sha": "d07b7b32f1a62fd74eaafd6a4c673b1ea3d06a46", "assignees": [], "requested_reviewers": [{"login": "thrau", "id": 3996682, "node_id": "MDQ6VXNlcjM5OTY2ODI=", "avatar_url": "https://avatars.githubusercontent.com/u/3996682?v=4", "gravatar_id": "", "url": "https://api.github.com/users/thrau", "html_url": "https://github.com/thrau", "followers_url": "https://api.github.com/users/thrau/followers", "following_url": "https://api.github.com/users/thrau/following{/other_user}", "gists_url": "https://api.github.com/users/thrau/gists{/gist_id}", "starred_url": "https://api.github.com/users/thrau/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/thrau/subscriptions", "organizations_url": "https://api.github.com/users/thrau/orgs", "repos_url": "https://api.github.com/users/thrau/repos", "events_url": "https://api.github.com/users/thrau/events{/privacy}", "received_events_url": "https://api.github.com/users/thrau/received_events", "type": "User", "user_view_type": "public", "site_admin": false}], "requested_teams": [], "labels": [], "milestone": null, "draft": false, "commits_url": "https://api.github.com/repos/localstack/localstack/pulls/7006/commits", "review_comments_url": "https://api.github.com/repos/localstack/localstack/pulls/7006/comments", "review_comment_url": "https://api.github.com/repos/localstack/localstack/pulls/comments{/number}", "comments_url": "https://api.github.com/repos/localstack/localstack/issues/7006/comments", "statuses_url": "https://api.github.com/repos/localstack/localstack/s