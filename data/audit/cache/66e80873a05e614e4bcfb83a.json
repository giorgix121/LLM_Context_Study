         # from the given string. For backwards compatibility we need to\n             # parse the string ourselves without removing leading spaces/tabs.\n             ast.parse(out, mode='eval')\n         )\n     except (ValueError, SyntaxError, MemoryError):\n         return out\n+\n+    if isinstance(evaled, string_types):\n+        quote = out[0]\n+        return f'{quote}{evaled}{quote}'\n+\n+    return evaled"}, {"sha": "a6c2befa15196f69f5fa1e7e01434aa687241256", "filename": "test/integration/targets/jinja2_native_types/runme.sh", "status": "modified", "additions": 1, "deletions": 0, "changes": 1, "blob_url": "https://github.com/ansible/ansible/blob/d34b5786858f699ef36da6785464021889eaa672/test%2Fintegration%2Ftargets%2Fjinja2_native_types%2Frunme.sh", "raw_url": "https://github.com/ansible/ansible/raw/d34b5786858f699ef36da6785464021889eaa672/test%2Fintegration%2Ftargets%2Fjinja2_native_types%2Frunme.sh", "contents_url": "https://api.github.com/repos/ansible/ansible/contents/test%2Fintegration%2Ftargets%2Fjinja2_native_types%2Frunme.sh?ref=d34b5786858f699ef36da6785464021889eaa672", "patch": "@@ -7,4 +7,5 @@ ansible-playbook runtests.yml -v \"$@\"\n ansible-playbook --vault-password-file test_vault_pass test_vault.yml -v \"$@\"\n ansible-playbook test_hostvars.yml -v \"$@\"\n ansible-playbook nested_undefined.yml -v \"$@\"\n+ansible-playbook test_preserving_quotes.yml -v \"$@\"\n unset ANSIBLE_JINJA2_NATIVE"}, {"sha": "5e9c76d628cae62296b23812579448f3f6a9a8cf", "filename": "test/integration/targets/jinja2_native_types/test_casting.yml", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/ansible/ansible/blob/d34b5786858f699ef36da6785464021889eaa672/test%2Fintegration%2Ftargets%2Fjinja2_native_types%2Ftest_casting.yml", "raw_url": "https://github.com/ansible/ansible/raw/d34b5786858f699ef36da6785464021889eaa672/test%2Fintegration%2Ftargets%2Fjinja2_native_types%2Ftest_casting.yml", "contents_url": "https://api.githu