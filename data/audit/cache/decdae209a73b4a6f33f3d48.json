[{"url": "https://api.github.com/repos/getsentry/sentry/pulls/39660", "id": 1076949665, "node_id": "PR_kwDOAA1TcM5AMPKh", "html_url": "https://github.com/getsentry/sentry/pull/39660", "diff_url": "https://github.com/getsentry/sentry/pull/39660.diff", "patch_url": "https://github.com/getsentry/sentry/pull/39660.patch", "issue_url": "https://api.github.com/repos/getsentry/sentry/issues/39660", "number": 39660, "state": "closed", "locked": true, "title": "feat(metrics): Standardize tests and fix overall flakiness [TET-437]", "user": {"login": "iambriccardo", "id": 15819674, "node_id": "MDQ6VXNlcjE1ODE5Njc0", "avatar_url": "https://avatars.githubusercontent.com/u/15819674?v=4", "gravatar_id": "", "url": "https://api.github.com/users/iambriccardo", "html_url": "https://github.com/iambriccardo", "followers_url": "https://api.github.com/users/iambriccardo/followers", "following_url": "https://api.github.com/users/iambriccardo/following{/other_user}", "gists_url": "https://api.github.com/users/iambriccardo/gists{/gist_id}", "starred_url": "https://api.github.com/users/iambriccardo/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/iambriccardo/subscriptions", "organizations_url": "https://api.github.com/users/iambriccardo/orgs", "repos_url": "https://api.github.com/users/iambriccardo/repos", "events_url": "https://api.github.com/users/iambriccardo/events{/privacy}", "received_events_url": "https://api.github.com/users/iambriccardo/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "body": "In this PR I propose a simple approach to standardize time management in our metrics layer tests. The refactor aims at solving the issues that led to flakiness in most tests.\r\n\r\nThe idea of this PR is to have a base class called `BaseMetricsLayerTestCase` that contains two methods:\r\n* `now` -> this is an abstract method used to enforce a certain style with respect to getting current time.\r\n* `store_metric_in_metrics_layer` -> this is a wrapper over the `store_metric` function that will automatically insert the metric at `now() - 1 second` in order to cover for right non-inclusivity in the `MetricsQuery`.\r\nEach class the inherits `BaseMetricsLayerTestCase` must then use the `@freeze_time()` decorator at the class level, effectively freezing time for each method belonging to that class. The frozen time can be decided but we have provided a `DEFAULT_FROZEN_TIME` for simplicity and correctness.\r\n* `build_metrics_query` -> this is a wrapper function that hides the `start` and `end` bounds from the query building and instead substitutes them with a simpler `before_now` that considers the `end` bound as always `self.now()`. It also simplifies the handling of `granularity` because it allows it to be specified in `h`, `m`... instead of numerical seconds.\r\n\r\n_This solution doesn't want to overgeneralize or create complex abstractions, instead it tries to find the simplest possible solution to at least enforce some standardization throughout metrics layer tests. Other more advanced solutions were proposed but we decided with @ahmedetefy to turn them down due to their unnecessary complexity._", "created_at": "2022-10-05T07:10:02Z", "updated_at": "2022-10-21T12:01:10Z", "closed_at": "2022-10-06T09:00:41Z", "merged_at": "2022-10-06T09:00:41Z", "merge_commit_sha": "c67c560f667e6fc7fee2c6d62ac3987ba54f89d5", "assignees": [], "requested_reviewers": [], "requested_teams": [], "labels": [{"id": 4207051418, "node_id": "LA_kwDOAA1TcM76woKa", "url": "https://api.github.com/repos/getsentry/sentry/labels/Scope:%20Backend", "name": "Scope: Backend", "color": "F5B000", "default": false, "description": "Automatically applied to PRs that change backend components", "archived_at": null, "archived_by": null}], "milestone": null, "draft": false, "commits_url": "https://api.github.com/repos/getsentry/sentry/pulls/39660/commits", "review_comments_url": "https://api.github.com/repos/getsentry/sentry/pulls/3966