 as e:\n         sentry_sdk.capture_exception(e)\n         metrics.incr("}, {"sha": "ca61fb856870e03a6c560e7d04f1520815eb6819", "filename": "src/sentry/profiles/utils.py", "status": "modified", "additions": 1, "deletions": 1, "changes": 2, "blob_url": "https://github.com/getsentry/sentry/blob/fcd73fea976eb9dd7017f300857c532cf567c6c0/src%2Fsentry%2Fprofiles%2Futils.py", "raw_url": "https://github.com/getsentry/sentry/raw/fcd73fea976eb9dd7017f300857c532cf567c6c0/src%2Fsentry%2Fprofiles%2Futils.py", "contents_url": "https://api.github.com/repos/getsentry/sentry/contents/src%2Fsentry%2Fprofiles%2Futils.py?ref=fcd73fea976eb9dd7017f300857c532cf567c6c0", "patch": "@@ -66,7 +66,7 @@ def increment(  # type: ignore\n         status_forcelist={502},\n         allowed_methods={\"GET\", \"POST\"},\n     ),\n-    timeout=30,\n+    timeout=10,\n     maxsize=10,\n     headers={\"Accept-Encoding\": \"br, gzip\"},\n )"}]}